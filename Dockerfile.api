FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        swi-prolog git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
ENV PETTA_HOME=/app/.vendor/PeTTa KABLA_MODE=deterministic
RUN python scripts/setup_petta.py && pip install --no-cache-dir -e "api[dev]"
WORKDIR /app/api
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "kabla.main:app", "--host", "0.0.0.0", "--port", "8000"]
