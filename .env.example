# Copy to .env and adjust. .env is git-ignored. Never commit real keys.

# deterministic = fixtures + templates, no LLM, no network (default, used for the demo)
# live          = LLM clause extraction from pasted contract text
KABLA_MODE=deterministic

# Where PeTTa lives (setup clones it to .vendor/PeTTa by default)
PETTA_HOME=.vendor/PeTTa

# Path to swipl if it is not on PATH (e.g. C:\Program Files\swipl\bin\swipl.exe)
SWIPL=swipl

# SQLite store and demo signing key directory (both git-ignored)
KABLA_DB=var/kabla.sqlite
KABLA_KEY_DIR=var/keys

# Live mode only. Leave empty in deterministic mode.
KABLA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KABLA_LLM_MODEL=

# Karani's voice (optional). Leave the key empty and the web app uses the
# browser's own speech synthesis instead. Audio is cached under var/voice/.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Web -> API base URL
VITE_API_URL=http://localhost:8000
