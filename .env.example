# Copy to .env and adjust. .env is git-ignored. Never commit real keys.

# deterministic = fixtures + templates, no LLM, no network (default, used for the demo)
# live          = LLM clause extraction from pasted contract text
KABLA_MODE=deterministic

# Where PeTTa lives (setup clones it to .vendor/PeTTa by default)
PETTA_HOME=.vendor/PeTTa

# Path to swipl if it is not on PATH (e.g. C:\Program Files\swipl\bin\swipl.exe)
SWIPL=swipl

# SQLite store and demo signing key directory (both git-ignored)
KABLA_DB=var/kabla.sqlite
KABLA_KEY_DIR=var/keys

# Live mode only. Leave empty in deterministic mode.
KABLA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KABLA_LLM_MODEL=
# Any OpenAI-compatible server for KABLA_LLM_PROVIDER=openai (tested: https://openrouter.ai/api/v1 with
# KABLA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b). Empty = api.openai.com.
KABLA_LLM_URL=

# Omega agent (scripts/omega_run.py). With ANTHROPIC_API_KEY or OPENAI_API_KEY above set, the agent uses that
# model to PHRASE skill results (a router picks the skill); with neither, an offline keyword router answers
# (not an LLM). All optional:
# OMEGA_LLM_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint; used with OPENAI_API_KEY)
#                                           (tested: https://openrouter.ai/api/v1 with OMEGA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b)
# OMEGA_LLM_MODEL=                          (default gpt-4o-mini / claude-3-5-haiku-latest)
# OMEGA_LLM_TIMEOUT=45                      (seconds per model call before falling back to offline)
# OMEGA_STALL_S=300                         (watchdog: restart the agent if its log is silent this long)

# Karani's voice (optional). Leave the key empty and the web app uses the
# browser's own speech synthesis instead. Audio is cached under var/voice/.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Web -> API base URL
VITE_API_URL=http://localhost:8000
